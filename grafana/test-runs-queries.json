{
  "metrics": [
    {
      "key": "bad_pictures",
      "expr": "sum(last_over_time(moonshine_client_frames_total{{sel}, result!=\"ok\"}[$__range])) or vector(0)",
      "empty": "not measured",
      "decimals": 0
    },
    {
      "key": "missing_clean",
      "expr": "sum(last_over_time(moonshine_client_frames_missing_total{{sel}, stream=\"clean\"}[$__range])) or vector(0)",
      "empty": "not measured",
      "decimals": 0
    },
    {
      "key": "frame_time_p99",
      "expr": "histogram_quantile(0.99, sum(last_over_time(moonshine_client_frame_interval_seconds{{sel}, stream=\"clean\"}[$__range]))) * $fps",
      "empty": "not measured",
      "decimals": 2
    },
    {
      "key": "fps_delivered",
      "expr": "100 * histogram_count(sum(last_over_time(moonshine_client_frame_interval_seconds{{sel}, stream=\"clean\"}[$__range]))) / histogram_sum(sum(last_over_time(moonshine_client_frame_interval_seconds{{sel}, stream=\"clean\"}[$__range]))) / $fps",
      "empty": "not measured",
      "decimals": 1
    },
    {
      "key": "server_p99_ms",
      "expr": "1000 * histogram_quantile(0.99, sum((last_over_time(moonshine_frame_duration_seconds{frame_kind=~\"delta|key\"}[$__range]) and on (stream_key) group by (stream_key) (last_over_time(moonshine_client_frames_total{{sel}}[$__range])))))",
      "empty": "not measured",
      "decimals": 2
    },
    {
      "key": "freeze_p95",
      "expr": "histogram_quantile(0.95, sum(last_over_time(moonshine_client_freeze_duration_seconds{{sel}}[$__range]))) * $fps",
      "empty": "no loss test",
      "decimals": 2
    },
    {
      "key": "recovered_without_keyframe",
      "expr": "100 * (histogram_count(sum(last_over_time(moonshine_client_freeze_duration_seconds{{sel}, recovered_by=\"recovery_frame\"}[$__range]))) or vector(0)) / histogram_count(sum(last_over_time(moonshine_client_freeze_duration_seconds{{sel}}[$__range])))",
      "empty": "no loss test",
      "decimals": 1
    },
    {
      "key": "click_median",
      "expr": "histogram_quantile(0.5, sum(last_over_time(moonshine_client_click_duration_seconds{{sel}}[$__range]))) * $fps",
      "empty": "no click test",
      "decimals": 2
    },
    {
      "key": "keyframes_per_switch",
      "expr": "sum((last_over_time(moonshine_frames_total{frame_kind=\"key\"}[$__range]) and on (stream_key) group by (stream_key) (last_over_time(moonshine_client_frames_total{{sel}, stream=\"clean\"}[$__range])))) / (sum((last_over_time(moonshine_content_switches_total{}[$__range]) and on (stream_key) group by (stream_key) (last_over_time(moonshine_client_frames_total{{sel}, stream=\"clean\"}[$__range])))) > 0)",
      "empty": "no HDR switch test",
      "decimals": 2
    },
    {
      "key": "load_fps",
      "expr": "100 * histogram_count(sum(last_over_time(moonshine_client_frame_interval_seconds{{sel}, stream=\"clean\", load=\"high\"}[$__range]))) / histogram_sum(sum(last_over_time(moonshine_client_frame_interval_seconds{{sel}, stream=\"clean\", load=\"high\"}[$__range]))) / $fps",
      "empty": "no GPU-load test",
      "decimals": 1
    },
    {
      "key": "peak_bitrate",
      "expr": "100 * max(last_over_time(moonshine_client_bitrate_peak_bit_per_second{{sel}, stream=\"clean\"}[$__range])) / max(last_over_time(moonshine_client_bitrate_requested_bit_per_second{{sel}, stream=\"clean\"}[$__range]))",
      "empty": "not measured",
      "decimals": 1
    }
  ]
}
