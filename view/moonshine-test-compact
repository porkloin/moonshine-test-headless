#!/bin/bash
# A smaller copy of a run's results.tar.gz, for attaching it where there's a size limit (GitHub's is 25 MB): the
# same files, with the metric points that repeat their series' previous value left out (moonshine-otel compact).
# The views and summaries it makes are the same. Written next to it as NAME-compact.tar.gz.
#
# With --no-traces, the traces are left out too (most of a full run's telemetry), as NAME-compact-no-traces.tar.gz:
# the summary is still the same, as it's made from the metrics, but Grafana has no per-frame traces to show.
#
#   moonshine-test-compact RESULTS.tar.gz [--no-traces]
set -euo pipefail
usage="usage: podman container runlabel compact ghcr.io/porkloin/moonshine-test-headless:view RESULTS.tar.gz [--no-traces]"
die() { echo "moonshine-test-compact: $*" >&2; exit 2; }
traces=1
in=
for arg; do
	case $arg in
	--no-traces) traces=0 ;;
	-*) die "unknown option $arg; $usage" ;;
	*) [ -z "$in" ] || die "$usage"; in=$arg ;;
	esac
done
[ -n "$in" ] || die "$usage"
name=$in
[[ $in == /* ]] || in=/results/${in#./}
[ -f "$in" ] || die "no $name in the current folder"
out=${in%.tar.gz}-compact.tar.gz
[ "$traces" = 1 ] || out=${in%.tar.gz}-compact-no-traces.tar.gz
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

mkdir "$work/run"
tar -xzf "$in" -C "$work/run" || die "can't unpack $name"
[ -d "$work/run/logs/otlp" ] || die "$name has no telemetry (logs/otlp)"
moonshine-otel compact "$work/run/logs/otlp" "$work/otlp"
[ "$traces" = 1 ] || find "$work/otlp" -name '*.traces.pb' -delete
rm -r "$work/run/logs/otlp"
mv "$work/otlp" "$work/run/logs/otlp"
(cd "$work/run" && tar -cf - -- *) | gzip -9 > "$out"
size=$(stat -c %s "$out")
echo "${out#/results/}: $(( size / 1000000 )) MB (was $(( $(stat -c %s "$in") / 1000000 )) MB)"
if [ "$size" -gt 25000000 ]; then
	if [ "$traces" = 1 ]; then
		echo "Still over GitHub's 25 MB limit. Leaving out the traces too keeps the same summary, without Grafana's"
		echo "per-frame traces:"
		echo "  podman container runlabel compact ghcr.io/porkloin/moonshine-test-headless:view $name --no-traces"
	else
		echo "Still over GitHub's 25 MB limit: attach it somewhere that takes bigger files (a release on your fork"
		echo "takes up to 2 GB) and link it from the pull request."
	fi
fi
